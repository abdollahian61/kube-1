# Copy to .env; never commit credentials
REGISTRY=repository.eways.co
REPOSITORY=docker-k8s
REGISTRY_USER=
# Prefer leaving blank for interactive login
REGISTRY_PASSWORD=
PLATFORM=linux/amd64
NERDCTL_NAMESPACE=k8s.io
VERIFY_REMOTE=true
# Keep true for production. Set false ONLY for an explicitly accepted lab test.
REQUIRE_DIGEST=true
