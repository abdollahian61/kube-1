# STARTING TEMPLATE ONLY: verify against the exact chosen Cilium Helm chart.
# Cluster is bootstrapped without kube-proxy; Cilium must reach the real API.
kubeProxyReplacement: true
k8sServiceHost: 192.168.1.203
k8sServicePort: 6443
ipam:
  mode: kubernetes
hubble:
  enabled: true
  relay:
    enabled: true
  ui:
    enabled: true
